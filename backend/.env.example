# SafeDeal Backend — Environment Variables

# Server
PORT=3001
NODE_ENV=development

# CORS - Frontend origin
FRONTEND_URL=http://localhost:3000

# ── Source 1: GovMap GIS ──────────────────────────────────────────────────────
# Register at: https://api.govmap.gov.il
GOVMAP_APP_ID=

# ── Source 5: CBS (הלמ"ס) ────────────────────────────────────────────────────
# No key needed — uses embedded static JSON data

# ── Source 6: Urban Renewal (התחדשות עירונית) ────────────────────────────────
# data.gov.il open API, no key needed
# Update resource ID if dataset changes:
URBAN_RENEWAL_RESOURCE_ID=d745a928-d861-4ffe-84a0-c8db5d90e7ee

# ── Source 4: XPLAN / Mavat (מינהל התכנון) ──────────────────────────────────
# ArcGIS REST API — no key needed (public GIS)
IPLAN_BASE_URL=https://ags.iplan.gov.il/arcgisiplan/rest/services/PlanningPublic

# ── Source 2 & 3: Nadlan.gov.il (רשות המסים + נדל"ן ממשלתי) ────────────────
NADLAN_BASE_URL=https://www.nadlan.gov.il/Nadlan.REST

# ── Source 7: Tabu OCR — Google Gemini API ──────────────────────────────────
# Get your free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Source 8: Municipal Engineering — data.gov.il ────────────────────────────
# Building permits dataset resource ID on data.gov.il
BUILDING_PERMITS_RESOURCE_ID=4a8cedd3-3085-48b8-8508-96f81d99c99f

# ── Source 9: Registrar of Companies ────────────────────────────────────────
ICA_BASE_URL=https://ica.justice.gov.il

# ── Source 10: Registrar of Pledges ─────────────────────────────────────────
# Requires government payment gateway integration
# Options: gov.il API Gateway, or 3rd-party services (DigiSign, SmartBet)
# PLEDGES_API_KEY=        # for future 3rd-party integration

# ── Source 11: Judicial — Net HaMishpat ─────────────────────────────────────
# Requires government identity verification + login
# Options: court.gov.il session cookies, or Nevo premium API
# JUDICIAL_API_KEY=       # for future Nevo/NetHaMishpat integration
